#!/usr/bin/env sh
# Pre-commit gate — runs checks for whichever project has staged changes.
# Escape hatch: `git commit --no-verify`. CI is the authoritative gate.
staged() { git diff --cached --name-only --diff-filter=ACMR; }

# dnd-app: Biome on staged files + renderer typecheck. Run from INSIDE dnd-app
# (matching CI's `working-directory: dnd-app` and the dungeon-scholar block below)
# so dnd-app/biome.json is the project root. Running biome from the repo root makes
# Biome treat the git root as the project root and reject dnd-app/biome.json as a
# nested root config ("Found a nested root configuration"). biome --staged still
# resolves repo-root-relative staged paths via git from within the subdir.
if staged | grep -q '^dnd-app/'; then
  ( cd dnd-app && ./node_modules/.bin/biome check --staged --no-errors-on-unmatched ) || exit 1
  ( cd dnd-app && npx tsc --noEmit -p tsconfig.web.json ) || exit 1
fi

# dungeon-scholar: Biome on staged files (S10/S25).
if staged | grep -q '^dungeon-scholar/'; then
  ( cd dungeon-scholar && npx biome check --staged --no-errors-on-unmatched ) || exit 1
fi

# Secret scan across the staged set (folded in from the old .githooks shim).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || exit 1
fi

# dungeon-scholar (VTT) pre-flight: when its files are staged, run its vitest
# suite so a dungeon-scholar-only commit gets a local gate too (the husky hook
# previously gated dnd-app alone). CI (.github/workflows/subprojects-ci.yml) is
# authoritative; this is a fast local pre-flight. Escape hatch: git commit --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only --diff-filter=ACMR | grep -q "^dungeon-scholar/"; then
  echo "[pre-commit] dungeon-scholar changes staged - running its tests..."
  ( cd dungeon-scholar && npm test --silent ) || exit 1
fi
