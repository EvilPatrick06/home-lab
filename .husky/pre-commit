#!/usr/bin/env sh
# Pre-commit gate (hooks run with cwd = git root). Escape hatch:
# `git commit --no-verify`. CI is the authoritative gate; this is a fast local
# pre-flight. Project-aware: only the projects with staged changes are checked.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Biome on staged files — run from the repo ROOT so git's repo-root-relative
# staged paths (`dnd-app/src/...`) resolve and Biome picks up dnd-app/biome.json
# per file. The old `cd dnd-app && biome check src/ --staged` matched 0 files
# (silent no-op, fixed 2026-06-23). --no-errors-on-unmatched: allow docs-only commits.
./dnd-app/node_modules/.bin/biome check --staged --no-errors-on-unmatched || exit 1

# dnd-app: typecheck the renderer config (broadest surface) when it has changes.
if printf '%s\n' "$STAGED" | grep -q '^dnd-app/'; then
  (cd dnd-app && npx tsc --noEmit -p tsconfig.web.json) || exit 1
fi

# dungeon-scholar: run its unit tests when it has staged changes (no lint/tsc script).
if printf '%s\n' "$STAGED" | grep -q '^dungeon-scholar/'; then
  (cd dungeon-scholar && npm test) || exit 1
fi

# Optional secret scan across staged files (folded in from the old .githooks/
# shim so a single core.hooksPath = .husky covers it). Skips if gitleaks absent.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || exit 1
fi
