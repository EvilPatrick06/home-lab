#!/usr/bin/env sh
# Pre-commit gate — runs checks for whichever project has staged changes.
# Escape hatch: `git commit --no-verify`. CI is the authoritative gate.
staged() { git diff --cached --name-only --diff-filter=ACMR; }

# dnd-app: Biome on staged files + renderer typecheck. Run from INSIDE dnd-app
# (matching CI's `working-directory: dnd-app` and the dungeon-scholar block below)
# so dnd-app/biome.json is the project root. Running biome from the repo root makes
# Biome treat the git root as the project root and reject dnd-app/biome.json as a
# nested root config ("Found a nested root configuration"). biome --staged still
# resolves repo-root-relative staged paths via git from within the subdir.
# NOTE (2026-07-02 integrator fix-forward): biome --staged from dnd-app breaks when
# dnd-app/mobile files are staged - mobile/biome.json is a second root config and
# Biome 2.x aborts with "nested root configuration". Pass explicit staged paths per
# project instead (dnd-app excluding mobile; mobile with its own pinned biome), which
# keeps traversal from discovering the other root. CI stays authoritative.
if staged | grep -q '^dnd-app/'; then
  DND_STAGED=$(staged | grep '^dnd-app/' | grep -v '^dnd-app/mobile/' | sed 's#^dnd-app/##')
  if [ -n "$DND_STAGED" ]; then
    ( cd dnd-app && ./node_modules/.bin/biome check --no-errors-on-unmatched $DND_STAGED ) || exit 1
    ( cd dnd-app && npx tsc --noEmit -p tsconfig.web.json ) || exit 1
  fi
fi
if staged | grep -q '^dnd-app/mobile/'; then
  MOB_STAGED=$(staged | grep '^dnd-app/mobile/' | sed 's#^dnd-app/mobile/##')
  ( cd dnd-app/mobile && npx --yes @biomejs/biome@2.5.0 check --no-errors-on-unmatched $MOB_STAGED ) || exit 1
fi

# dungeon-scholar: Biome on staged files (S10/S25). Run from INSIDE dungeon-scholar
# so its biome.json is the project root (same per-project scoping as the dnd-app
# block above — avoids Biome's "nested root configuration" error that occurs when
# biome runs from the repo root and discovers both subproject roots at once).
# dungeon-scholar has no local biome dependency, so invoke the correctly-scoped,
# version-pinned package explicitly (matching its package.json lint script). Bare
# `npx biome` must NOT be used: it resolves to an unrelated abandoned `biome`
# package, not the linter, and aborts in non-interactive (hook) contexts.
if staged | grep -q '^dungeon-scholar/'; then
  ( cd dungeon-scholar && npx --yes @biomejs/biome@2.5.0 check --staged --no-errors-on-unmatched ) || exit 1
fi

# Secret scan across the staged set (folded in from the old .githooks shim).
# If gitleaks is absent we WARN loudly rather than skip silently, and rely on
# the server-side secret-scan workflow (.github/workflows/secret-scan.yml) as
# the authoritative backstop that --no-verify / a missing local binary cannot bypass.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || exit 1
else
  echo "[pre-commit] WARNING: gitleaks not installed - local secret scan SKIPPED." >&2
  echo "[pre-commit]   Install it (https://github.com/gitleaks/gitleaks) for local pre-commit scanning." >&2
  echo "[pre-commit]   The secret-scan CI workflow still runs on push/PR as the backstop." >&2
fi

# dungeon-scholar (VTT) pre-flight: when its files are staged, run its vitest
# suite so a dungeon-scholar-only commit gets a local gate too (the husky hook
# previously gated dnd-app alone). CI (.github/workflows/dungeon-scholar-ci.yml) is
# authoritative; this is a fast local pre-flight. Escape hatch: git commit --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only --diff-filter=ACMR | grep -q "^dungeon-scholar/"; then
  echo "[pre-commit] dungeon-scholar changes staged - running its tests..."
  ( cd dungeon-scholar && npm test --silent ) || exit 1
fi

# bmo/pi (Python) pre-flight: when pi files are staged, run ruff on the staged
# Python files + the no-new-print ratchet, giving bmo/pi the same fast local floor
# the JS projects get. CI (.github/workflows/bmo-pi-pytest.yml) runs the full
# ruff+pytest gate on push and stays authoritative. Escape hatch: git commit --no-verify.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^bmo/pi/.*\.py$'; then
  PY_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '^bmo/pi/.*\.py$')
  if command -v ruff >/dev/null 2>&1; then
    echo "[pre-commit] bmo/pi Python staged - running ruff check..."
    ( cd bmo/pi && ruff check $(echo "$PY_STAGED" | sed 's#^bmo/pi/##') ) || exit 1
  else
    echo "[pre-commit] WARNING: ruff not installed - bmo/pi lint SKIPPED (CI still gates)." >&2
  fi
  if [ -x bmo/pi/scripts/check-no-new-prints.sh ]; then
    ( cd bmo/pi && ./scripts/check-no-new-prints.sh ) || exit 1
  fi
fi

# oracle-worker pre-flight: when its files are staged, run its npm test (fast),
# matching the local-floor parity the other projects have. CI
# (.github/workflows/oracle-worker-ci.yml) stays authoritative.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^oracle-worker/'; then
  echo "[pre-commit] oracle-worker changes staged - running its tests..."
  ( cd oracle-worker && npm test --silent ) || exit 1
fi
