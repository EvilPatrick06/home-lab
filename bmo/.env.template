# BMO Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.template .env && nano .env
#
# All commands via "bash bmo.sh <command>" will source this file
# automatically. Values here override script defaults.
#
# At boot, app.py runs a config preflight (services/config_preflight.py) that
# logs which providers are configured and which features are degraded by a
# missing key. Check the boot log or GET /api/health/full ("config" block).
# Set BMO_PREFLIGHT_STRICT=1 to hard-fail boot when a REQUIRED key is missing.

# ── Cloud AI API Keys ─────────────────────────────────────────────────
# Primary LLM (Gemini 3 Pro / Flash)
GEMINI_API_KEY=""                 # https://aistudio.google.com/apikey

# D&D DM model (Claude Opus 4.6)
ANTHROPIC_API_KEY=""              # https://console.anthropic.com/settings/keys

# Speech-to-Text (Groq Whisper)
GROQ_API_KEY=""                   # https://console.groq.com/keys

# Text-to-Speech (Fish Audio)
FISH_AUDIO_API_KEY=""             # https://fish.audio/account/api-keys — rotate before committing!
FISH_AUDIO_VOICE_ID="94b4570683534e37993fdffbd47d084b"  # BMO voice clone

# Vision (Google Cloud Vision)
GOOGLE_VISION_API_KEY=""          # https://console.cloud.google.com/apis/credentials

# ── Model Selection ───────────────────────────────────────────────────
BMO_PRIMARY_MODEL="gemini-3-pro"  # General assistant
BMO_ROUTER_MODEL="gemini-3-flash" # Fast routing / simple queries
BMO_DND_MODEL="claude-opus-4.6"   # D&D Dungeon Master

# ── Raspberry Pi ──────────────────────────────────────────────────────
# deploy.sh host resolution order:
# 1) PI_HOST (explicit override)
# 2) PI_HOSTNAME.local / PI_HOSTNAME (LAN + mDNS)
# 3) PI_TAILSCALE_HOST (remote)
# 4) PI_IP (manual fallback)
PI_HOST=""                        # Explicit SSH host override (optional)
PI_HOSTNAME="bmo"                 # Expected hostname on Pi
PI_TAILSCALE_HOST=""              # Example: bmo.tailnet-name.ts.net
PI_IP=""                          # Manual fallback IP (leave blank for travel/DHCP)
PI_USER="patrick"
PI_WEB_HOST=""                    # Optional LAN web URL host shown by deploy.sh
PI_SSH_ALIAS="bmo"                # Recommended local alias in ~/.ssh/config
PI_TIMEZONE="America/Denver"
BMO_AUTO_SYSTEM_TIMEZONE="1"      # 1=yes auto set Pi timezone from detected location
# Configured (pinned) location. These coords are Colorado Springs / Briargate, CO.
BMO_WEATHER_LATITUDE="38.9364"    # Configured latitude (Colorado Springs / Briargate)
BMO_WEATHER_LONGITUDE="-104.7595" # Configured longitude (Colorado Springs / Briargate)
BMO_WEATHER_LOCATION_LABEL="Colorado Springs, CO"  # Display label for the configured location
# Pin location to the configured coords above and SKIP IP geolocation. IP geo on
# this box (Cloudflare tunnel / ISP egress) collapses to the US centroid (~Kansas)
# and silently overrode the real location. 1=pin (recommended); 0=trust IP geo;
# unset=auto-pin whenever both coords above are set.
BMO_LOCATION_PIN="1"

# ── Flask / App ───────────────────────────────────────────────────────
SECRET_KEY=""                     # Flask session secret (auto-generated if empty)

# ── NPC Voice IDs (Fish Audio, optional) ──────────────────────────────
# Set these after uploading NPC voice clones to Fish Audio
# FISH_AUDIO_NPC_GRUFF_DWARF=""
# FISH_AUDIO_NPC_MYSTERIOUS_ELF=""
# FISH_AUDIO_NPC_BOOMING_DRAGON=""
# FISH_AUDIO_NPC_WHISPERY_ROGUE=""
# FISH_AUDIO_NPC_ELDERLY_WIZARD=""
# FISH_AUDIO_NPC_CHEERFUL_BARD=""
# FISH_AUDIO_NPC_STERN_GUARD=""
# FISH_AUDIO_NPC_TAVERN_KEEPER=""

# ── TV + VTT (LAN — override if DHCP / hostnames differ) ─────────────
BMO_TV_HOST="10.10.20.194"        # Samsung TV for ADB; mDNS hostname ok if it resolves
# PHASE-22: Pi→VTT sync. EMPTY/UNSET disables Pi→VTT sync entirely (no retry
# threads). Set to the VTT host's sync receiver, e.g. http://10.0.0.5:5001
VTT_SYNC_URL=""
# Shared secret for the VTT sync receiver's bearer gate — must equal the VTT's
# BMO_API_KEY (app settings → bmoApiKey). Falls back to this file's BMO_API_KEY.
VTT_SYNC_TOKEN=""

# ── Monitoring / Alerts ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=""            # Discord webhook for BMO alerts (Server Settings → Integrations → Webhooks)

# ── Discord Bots ──────────────────────────────────────────────────────
DISCORD_DM_BOT_TOKEN=""           # DM bot token (Discord Developer Portal → Bot)
DISCORD_SOCIAL_BOT_TOKEN=""       # Social bot token (Discord Developer Portal → Bot)
DISCORD_GUILD_ID=""               # Server (guild) ID for slash command registration
DISCORD_DM_VOICE_CHANNEL=""       # DM-bot voice channel name (default "🗺️ | Dungeon")
DISCORD_DM_VOICE_CHANNEL_ID=""    # DM-bot voice channel numeric ID (wins over name)
DM_BOT_CONTROL_PORT="5006"        # loopback control server inside bmo-dm-bot (app.py proxies here)
DISCORD_PBP_CHANNEL="play-by-post" # PHASE-36 play-by-post: text channel NAME for turn pings
DISCORD_PBP_CHANNEL_ID=""         # play-by-post text channel numeric ID (wins over name)
PBP_REMINDER_TICK_SECONDS="600"   # play-by-post reminder-loop tick interval (seconds)

# ── Discord OAuth2 (VTT user login / cloud accounts) ──────────────────
# A SEPARATE OAuth2 client from the bots above (Discord Developer Portal → your
# application → OAuth2). The redirect URI must be registered there EXACTLY.
# Powers /api/auth/* ("Sign in with Discord") + per-user cloud sync.
DISCORD_OAUTH_CLIENT_ID=""        # Application (Client) ID
DISCORD_OAUTH_CLIENT_SECRET=""    # OAuth2 Client Secret — sensitive, never commit
DISCORD_OAUTH_REDIRECT_URI="https://bmo.mybmoai.work/api/auth/discord/callback"
# BMO_ACCOUNT_TOKEN_TTL="2592000" # account session lifetime in seconds (default 30d)

# ── Cloudflare (optional, for TURN relay) ─────────────────────────────
CF_TUNNEL_ID=""
CF_ACCOUNT_ID=""
CLOUDFLARE_DOMAIN="bmo.mybmoai.work"

# ── Hardware kill-switches (optional) ─────────────────────────────────
# Set to 1 to skip initializing a hardware component inside bmo.service —
# e.g. while a display/camera cable is broken or the part is removed.
# (The kiosk screen is its own unit: `sudo systemctl disable --now bmo-kiosk`.)
# BMO_DISABLE_OLED=1                # skip the OLED face display
# BMO_DISABLE_CAMERA=1              # skip the picamera2 camera service

# ── Cloudflare Access JWT trust (optional) ──────────────────────────────
# Lets the owner — already authenticated at the Cloudflare Access edge — reach the
# key-gated admin surface (/bmo, /ide, control APIs) through the tunnel with no
# Bearer. Flask verifies the Access JWT (signature vs the team JWKS + aud + iss).
# AUD = the Access app's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional second gate for the IDE's code-execution surface (comma-separated emails):
CF_ACCESS_ALLOWED_EMAILS=
