[Unit]
Description=BMO Social Discord Bot — Music, Chat & Fun
After=network-online.target time-sync.target bmo.service
Wants=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Liveness watchdog: the bot pings WATCHDOG=1 only while its Discord gateway
# is connected (bot.is_ready()); a stalled event loop misses the ping and
# systemd restarts the unit. TimeoutStartSec covers initial gateway connect.
WatchdogSec=120
TimeoutStartSec=120
User=patrick
WorkingDirectory=/home/patrick/home-lab-deploy/bmo/pi
EnvironmentFile=/home/patrick/home-lab-deploy/bmo/pi/.env
ExecStart=/home/patrick/home-lab-deploy/bmo/pi/venv/bin/python -m bots.discord_social_bot
Restart=on-failure
RestartSec=10

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Sandbox hardening — bot is network + voice only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/patrick/home-lab-deploy/bmo/pi/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

# Logging — journald; also: `journalctl -u bmo-social-bot -f`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
