#!/usr/bin/env bash
# notify.sh — BMO notification router (board-first; SMS only as failsafe).
# STABLE signature: notify.sh <sev> <subject> <body>   (severity: info|warn|error)
# Routine notices go to the BMO status board via notify-board, NOT SMS.
# Agent callers default to the 🤖 Agents section. NON-ACTIONABLE agent FYIs
# (info severity, no explicit NOTIFY_BOARD_CATEGORY) are dropped so the board
# only shows things that need action. Life feeds set NOTIFY_BOARD_CATEGORY to
# post info/today items (calendar, digests) which DO belong on the board.
# SMS (notify-sms.sh) fires only when the board is unreachable, or NOTIFY_FORCE_SMS=1.
set -u
TOOLS_DIR="${HOME}/.claude-tools"
LOG="${TOOLS_DIR}/notify.log"
SMS="${TOOLS_DIR}/notify-sms.sh"
BOARD="/home/patrick/bmo-board/notify-board"

severity="${1:-info}"
subject="${2:-BMO alert}"
body="${3:-}"
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
touch "${LOG}" 2>/dev/null || true

# Failsafe: forced SMS (board_watchdog / explicit override).
if [[ "${NOTIFY_FORCE_SMS:-0}" == "1" ]]; then
  exec "${SMS}" "${severity}" "${subject}" "${body}"
fi

case "${severity}" in
  error)        bsev="critical" ;;
  warn|warning) bsev="warning"  ;;
  *)            bsev="info"      ;;
esac
cat="${NOTIFY_BOARD_CATEGORY:-agent}"

# Non-actionable agent FYI (info, no explicit category) → don't clutter the board.
if [[ "${bsev}" == "info" && -z "${NOTIFY_BOARD_CATEGORY:-}" ]]; then
  echo "$(stamp) SKIP non-actionable agent info :: ${subject}" >> "${LOG}"
  exit 0
fi

key=$(printf '%s' "${subject}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-48)
[[ -z "${key}" ]] && key="alert"
detail=$(printf '%s' "${body}" | tr '\n' ' ' | cut -c1-200)

if [[ -x "${BOARD}" ]] && "${BOARD}" set "${cat}" "${cat}:${key}" "${cat}" "${subject}" --detail "${detail}" --severity "${bsev}" >>"${LOG}" 2>&1; then
  echo "$(stamp) BOARD [${severity}/${cat}] ${subject} (${cat}:${key})" >> "${LOG}"
  exit 0
fi
echo "$(stamp) BOARD-FAILED -> SMS fallback [${severity}] ${subject}" >> "${LOG}"
exec "${SMS}" "${severity}" "${subject}" "${body}"
