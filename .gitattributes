# Enforce LF line endings for all text files
* text=auto eol=lf
# Ensure these are always treated as text
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
# Keep these as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.wav binary
*.ogg binary
*.pdf filter=lfs diff=lfs merge=lfs -text
*.PDF filter=lfs diff=lfs merge=lfs -text
*.asar filter=lfs diff=lfs merge=lfs -text
*.blockmap filter=lfs diff=lfs merge=lfs -text
dnd-app/docs/phases/QA/screenshots/*.png filter=lfs diff=lfs merge=lfs -text
dnd-app/docs/phases/QA/screenshots/*.jpg filter=lfs diff=lfs merge=lfs -text
dnd-app/docs/phases/QA/screenshots/*.jpeg filter=lfs diff=lfs merge=lfs -text
dnd-app/docs/phases/QA/screenshots/*.gif filter=lfs diff=lfs merge=lfs -text
dnd-app/docs/phases/QA/screenshots/*.webp filter=lfs diff=lfs merge=lfs -text

# --- Append-only log docs: union merge ---------------------------------------
# Concurrent appends from parallel automated-agent branches (auto/<agent-id>)
# auto-merge instead of conflicting. See docs/AUTOMATED-AGENT-GIT-WORKFLOW.md.
# Logs live in docs/logs/ (migrated 2026-06-23). Anchored patterns are canonical.
docs/logs/ISSUES-LOG*           merge=union
docs/logs/BMO-ISSUES-LOG*       merge=union
docs/logs/SUGGESTIONS-LOG*      merge=union
docs/logs/BMO-SUGGESTIONS-LOG*  merge=union
docs/logs/SECURITY-LOG*         merge=union
docs/logs/RESOLVED-*            merge=union
docs/logs/BMO-RESOLVED-*        merge=union
# TEMPORARY transition bridge - bare basename globs keep union merge working for
# the old docs/<LOG>.md paths (symlinks today, or a regular file if a scanner
# re-creates one before scheduled-task prompts are updated). REMOVE these seven
# lines together with the docs/<LOG>.md bridge symlinks once every scheduled-task
# prompt points at docs/logs/. See docs/AUTOMATED-AGENT-GIT-WORKFLOW.md.
ISSUES-LOG*           merge=union
BMO-ISSUES-LOG*       merge=union
SUGGESTIONS-LOG*      merge=union
BMO-SUGGESTIONS-LOG*  merge=union
SECURITY-LOG*         merge=union
RESOLVED-*            merge=union
BMO-RESOLVED-*        merge=union
