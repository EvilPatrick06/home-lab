# Enforce LF line endings for all text files
* text=auto eol=lf
# Ensure these are always treated as text
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
# Keep these as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.wav binary
*.ogg binary
*.pdf filter=lfs diff=lfs merge=lfs -text
*.PDF filter=lfs diff=lfs merge=lfs -text
*.asar filter=lfs diff=lfs merge=lfs -text
*.blockmap filter=lfs diff=lfs merge=lfs -text
# QA-screenshot LFS: generic ** globs cover every project (dnd-app, dungeon-scholar,
# bmo, and any future one) plus the bmo QA/completed/ variant, so a new phases/QA
# dir or screenshot extension is LFS-tracked without editing this file. Mirrors the
# **/docs/DESIGN-CONSTRAINTS.md idiom below.
**/docs/phases/QA/screenshots/*.png filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/screenshots/*.jpg filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/screenshots/*.jpeg filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/screenshots/*.gif filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/screenshots/*.webp filter=lfs diff=lfs merge=lfs -text
# The bmo QA flow also keeps a completed/ subdir of screenshots; cover it with
# the same generic ** globs so archived QA shots stay LFS-tracked.
**/docs/phases/QA/completed/screenshots/*.png filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/completed/screenshots/*.jpg filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/completed/screenshots/*.jpeg filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/completed/screenshots/*.gif filter=lfs diff=lfs merge=lfs -text
**/docs/phases/QA/completed/screenshots/*.webp filter=lfs diff=lfs merge=lfs -text

# --- Append-only log docs: union merge ---------------------------------------
# Concurrent appends from parallel automated-agent branches (auto/<agent-id>)
# auto-merge instead of conflicting. See docs/AUTOMATED-AGENT-GIT-WORKFLOW.md.
# Logs live in docs/logs/ (migrated 2026-06-23). Anchored patterns are canonical.
docs/logs/ISSUES-LOG*           merge=union
docs/logs/BMO-ISSUES-LOG*       merge=union
docs/logs/SUGGESTIONS-LOG*      merge=union
docs/logs/BMO-SUGGESTIONS-LOG*  merge=union
docs/logs/SECURITY-LOG*         merge=union
docs/logs/RESOLVED-*            merge=union
docs/logs/BMO-RESOLVED-*        merge=union

# Automated-agent durable-knowledge docs (design-gotcha/info targets per
# docs/LOG-INSTRUCTIONS.md) are append-only like the logs: union-merge their
# concurrent appends from parallel auto/<agent-id> branches. See
# docs/AUTOMATED-AGENT-GIT-WORKFLOW.md Rule 2.
**/docs/DESIGN-CONSTRAINTS.md   merge=union
