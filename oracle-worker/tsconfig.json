{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
