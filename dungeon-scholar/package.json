  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:ci": "npm audit --omit=dev --audit-level=moderate",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
