{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": ["../biome.base.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "!!**/dist", "!!**/node_modules"]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "recommended": false },
      "complexity": { "noForEach": "off", "noUselessFragments": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noAssignInExpressions": "warn" },
      "style": { "useNodejsImportProtocol": "off", "noParameterAssign": "off" },
      "correctness": { "useExhaustiveDependencies": "warn", "noUnusedImports": "warn", "noUnusedFunctionParameters": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.js", "**/*.test.jsx", "**/*.test.mjs"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
