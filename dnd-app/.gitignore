# Biome (biome.json vcs.useIgnoreFile) requires a ignore file in this directory.
# Monorepo-wide rules: ../.gitignore (do not symlink — breaks Git + Biome on this setup).

node_modules/
out/
dist/
*.log
# Defensive: literal `C:` dir from a Windows-style userData path on a Linux run
C:/
# rollup-plugin-visualizer (ANALYZE=1 npm run build)
bundle-stats.html
# Bundled Ollama binary — fetched at build time per platform, not source-tracked
resources/ollama/
.ollama-download-tmp/

# PHASE-38 — generated TypeDoc plugin-API docs (regenerate with `npm run docs:api`)
docs/api/

# Web (browser) build output
dist-web/

# --- web-embed + mobile/PWA WIP: exclude deps & build output (keep source only) ---
# Embed build output
dist-embed/
# Mobile (Expo/RN) app — deps and generated output
mobile/node_modules/
mobile/assets/embed/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/dist/

# Postinstall-generated pdfjs worker (copied from node_modules/pdfjs-dist by
# scripts/build/postinstall.mjs on every install). Was previously COMMITTED and
# drifted from the locked pdfjs-dist version whenever Dependabot bumped the lock
# without regenerating it (ISSUES-LOG-DNDAPP 2026-07-17): every npm ci left the
# tree dirty, and a stale checkout paired mismatched API/Worker versions at runtime.
src/renderer/public/pdf.worker.min.mjs
