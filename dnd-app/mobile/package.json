{
  "name": "dnd-vtt-mobile",
  "version": "2.6.3",
  "private": true,
  "description": "Dungeon Table Online — React Native (Expo) Android client. Embeds the in-game renderer (PixiJS map + Three.js dice) in a WebView and reuses the desktop/web TypeScript logic over a typed window.api bridge.",
  "main": "index.ts",
  "scripts": {
    "prestart": "node scripts/ensure-embed.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:embed": "npm --prefix .. run build:embed && node scripts/sync-embed.mjs && node scripts/sync-shared.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "fflate": "^0.8.2",
    "nativewind": "^4.1.23",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "~0.10.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.0",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^20.4.0",
    "typescript": "~6.0.3"
  }
}
