{
  "name": "dnd-vtt-mobile",
  "version": "2.6.3",
  "private": true,
  "description": "Dungeon Table Online — React Native (Expo) Android client. Embeds the in-game renderer (PixiJS map + Three.js dice) in a WebView and reuses the desktop/web TypeScript logic over a typed window.api bridge.",
  "main": "index.ts",
  "scripts": {
    "prestart": "node scripts/ensure-embed.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:embed": "npm --prefix .. run build:embed && node scripts/sync-embed.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.3",
    "expo-file-system": "~18.1.5",
    "expo-sqlite": "~15.2.9",
    "expo-asset": "~11.1.5",
    "expo-status-bar": "~2.2.3",
    "fflate": "^0.8.2",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-webview": "13.13.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "eas-cli": "^16.3.3",
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^2.5.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
