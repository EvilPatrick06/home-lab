{
  "name": "dnd-vtt-mobile",
  "version": "2.8.2",
  "private": true,
  "description": "Dungeon Table Online — React Native (Expo) Android client. Embeds the in-game renderer (PixiJS map + Three.js dice) in a WebView and reuses the desktop/web TypeScript logic over a typed window.api bridge.",
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node scripts/ensure-embed.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:embed": "npm --prefix .. run build:embed && node scripts/sync-embed.mjs && node scripts/sync-shared.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --omit=dev --audit-level=moderate",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~57.0.4",
    "expo-asset": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-file-system": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.6",
    "fflate": "^0.8.2",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.10.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.5.1",
    "@expo/config-types": "^57.0.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^20.4.0",
    "lightningcss": "1.30.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.8.13",
    "ajv": ">=8.18.0",
    "diff": ">=8.0.3",
    "joi": ">=17.13.4",
    "minimatch": ">=5.1.8",
    "node-forge": ">=1.4.0",
    "tar": ">=7.5.16",
    "ts-deepmerge": ">=8.0.0",
    "uuid": ">=11.1.1",
    "yaml": ">=2.8.3",
    "lightningcss": "1.30.1"
  }
}
