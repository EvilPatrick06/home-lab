# EAS Build upload ignore list. When this file exists, EAS uses it INSTEAD of
# .gitignore to decide what to upload. We intentionally DO upload
# assets/embed.zip (gitignored, but require()'d by src/embed/embed-loader.ts at
# bundle time) while still excluding it from git.

# Dependencies (reinstalled in the cloud)
node_modules/

# Expo / build outputs
.expo/
dist/
web-build/

# Native projects (regenerated by `expo prebuild` in the cloud)
/android
/ios

# Redundant unzipped embed (only the .zip is required at bundle/runtime)
assets/embed/

# Secrets / signing — never upload
*.keystore
*.jks
google-service-account.json
.env*.local

# Misc
*.log
.DS_Store
npm-debug.*
