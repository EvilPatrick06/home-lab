# EAS Build upload ignore list. assets/embed.zip is intentionally NOT listed —
# it is required at bundle time (src/embed/embed-loader.ts require()s it) and is
# the only embed artifact the app needs at runtime.

# Dependencies (reinstalled in the cloud)
node_modules/

# Redundant unzipped embed dir (~125MB) — only embed.zip is used; the app
# unzips it into the cache at runtime, so the loose dir is dead weight.
assets/embed/

# Expo / build outputs
.expo/
dist/
web-build/

# Native projects (regenerated by `expo prebuild` in the cloud)
/android
/ios

# Secrets / signing — never upload
*.keystore
*.jks
google-service-account.json
.env*.local

# Misc
*.log
.DS_Store
npm-debug.*
