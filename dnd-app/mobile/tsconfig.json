{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["react", "react-native"],
    "paths": {
      "@app/*": ["src/*"],
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["../src/renderer/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "assets.d.ts",
    "../src/shared/bridge/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
