{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": [
      "react",
      "react-native"
    ],
    "paths": {
      "@app/*": [
        "src/*"
      ],
      "@shared/*": [
        "../src/shared/*"
      ],
      "@renderer/*": [
        "../src/renderer/src/*"
      ],
      "@msgpack/msgpack": [
        "node_modules/@msgpack/msgpack"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "assets.d.ts",
    "../src/shared/bridge/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "../src/shared/**/*.test.ts",
    "../src/shared/**/*.test.tsx",
    "node_modules"
  ]
}
