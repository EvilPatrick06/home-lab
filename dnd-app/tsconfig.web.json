{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "./out",
    "rootDir": ".",
    "strict": true,
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@data/*": [
        "./src/renderer/public/data/*"
      ]
    },
    "types": [
      "react",
      "react-dom"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.json",
    "src/renderer/public/data/**/*.json",
    "src/preload/index.d.ts",
    "src/shared/**/*",
    "src/web/**/*",
    "src/main/ai/ai-schemas.ts",
    "src/main/ai/stat-mutations-core.ts",
    "src/main/ai/character-conditions.ts",
    "src/main/ai/types.ts",
    "src/main/ai/clients/llm-provider.ts",
    "src/main/ai/clients/model-routing.ts"
  ]
}
