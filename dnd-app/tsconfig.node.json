{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./out",
    "rootDir": ".",
    "strict": true
  },
  "include": [
    "src/main/**/*",
    "src/main/data/**/*.json",
    "src/preload/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "vite.web.config.ts"
  ]
}
