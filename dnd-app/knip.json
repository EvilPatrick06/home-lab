{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "electron.vite.config.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "src/renderer/src/types/**/*.ts",
    "src/shared/types/**/*.ts",
    "src/shared/ipc-schemas.ts",
    "src/renderer/src/systems/types.ts",
    "src/renderer/src/stores/game/types.ts",
    "src/renderer/src/services/game-actions/types.ts",
    "src/renderer/src/components/game/map/map-canvas/types.ts",
    "src/main/ai/types.ts",
    "src/renderer/src/services/plugin-system/plugin-api.ts",
    "src/renderer/src/services/plugin-system/plugin-registry-data.ts",
    "src/renderer/src/network/index.ts",
    "src/renderer/src/network/schemas.ts",
    "src/renderer/src/network/message-types.ts",
    "src/main/discord-integration/index.ts",
    "src/renderer/src/components/library/index.ts",
    "src/renderer/src/components/game/game-layout/index.ts",
    "src/renderer/src/services/chat-commands/index.ts",
    "src/renderer/src/types/data/index.ts",
    "src/renderer/src/constants/index.ts",
    "src/renderer/src/constants/damage-types.ts",
    "src/renderer/src/pages/library/library-constants.ts",
    "src/renderer/src/services/combat/damage-resolver.ts",
    "src/renderer/src/services/combat/attack-resolver.ts",
    "src/renderer/src/services/combat/combat-resolver.ts",
    "src/renderer/src/services/io/combat-log-export.ts",
    "src/renderer/src/components/game/map/map-overlay-effects.ts",
    "src/main/ai/context-builder.ts",
    "src/web/main.web.tsx"
  ],
  "ignore": [
    "src/renderer/public/pdf.worker.min.mjs",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "dpdm",
    "jscpd",
    "license-checker",
    "lockfile-lint",
    "npm-check-updates",
    "oxlint",
    "type-coverage"
  ],
  "ignoreBinaries": [
    "which",
    "nvidia-smi",
    "taskkill",
    "pkill"
  ]
}
