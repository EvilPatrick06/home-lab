{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "extends": ["../biome.base.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "!!**/out",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/resources",
      "!!src/renderer/public/pdf.worker.min.mjs"
    ],
    "maxSize": 1572864
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noForEach": "off", "noUselessFragments": "off" },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConfusingVoidType": "off",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "off"
      },
      "a11y": { "recommended": false },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "noParameterAssign": "off",
        "useDefaultParameterLast": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "off",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test-helpers.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "complexity": {
            "noBannedTypes": "off",
            "useArrowFunction": "off"
          }
        }
      }
    }
  ]
}
