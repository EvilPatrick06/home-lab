# Phase 19d — Windows code-signing configuration (optional).
#
# Copy to `.env.signing` and fill in to produce a SIGNED Windows installer.
# When these are unset, the build still succeeds but ships UNSIGNED (users get
# a SmartScreen "unknown publisher" prompt). `.env.signing` is gitignored.
#
# Load before a release build, e.g.:
#   set -a && source .env.signing && set +a && npm run build:win   # bash
#
# CI: store CSC_LINK as a base64-encoded secret; electron-builder writes it to a
# temp .pfx and points CSC_LINK at that file.

# Path to the code-signing certificate (.pfx)
CSC_LINK=

# Password for the .pfx
CSC_KEY_PASSWORD=
