{
  "name": "dnd-vtt",
  "version": "2.4.5",
  "description": "D&D Virtual Tabletop - Desktop app for online Dungeons & Dragons",
  "homepage": "https://github.com/EvilPatrick06/home-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvilPatrick06/home-lab.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepare": "cd .. && husky dnd-app/.husky",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/build/postinstall.mjs",
    "build:win": "npm run build:index && electron-vite build && electron-builder --win",
    "build:linux": "npm run build:index && electron-vite build && electron-builder --linux",
    "build:mac": "npm run build:index && electron-vite build && electron-builder --mac",
    "build:cross": "npm run build:index && electron-vite build && electron-builder --win --linux",
    "prerelease": "node scripts/build/prerelease-clean.mjs",
    "release": "npm run prerelease && npm run build:index && electron-vite build && npm run verify:build && electron-builder --win --publish always",
    "release:linux": "npm run prerelease && npm run build:index && electron-vite build && npm run verify:build && electron-builder --linux --publish always",
    "release:mac": "npm run prerelease && npm run build:index && electron-vite build && npm run verify:build && electron-builder --mac --publish always",
    "release:all": "npm run prerelease && npm run build:index && electron-vite build && npm run verify:build && electron-builder --win --linux --publish always",
    "release:cut": "node scripts/release/cut.mjs",
    "check:release": "npm run lint && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && npm test",
    "build:index": "node scripts/build/build-chunk-index.mjs",
    "verify:build": "node scripts/build/verify-build.mjs",
    "validate:5e": "node scripts/audit/check-5e-cross-refs.mjs",
    "validate:content": "tsx scripts/audit/validate-content-vs-schemas.ts",
    "i18n:gen-pseudo": "node scripts/i18n/gen-pseudo-locale.mjs",
    "i18n:gen-keys": "node scripts/i18n/gen-key-union.mjs",
    "gen:ipc-surface": "node scripts/build/gen-ipc-surface.mjs",
    "sync:doc-counts": "node scripts/build/sync-doc-counts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:forbidden": "node scripts/lint/forbidden-patterns.mjs",
    "format": "biome format --write src/",
    "audit:ci": "npm audit --audit-level=moderate --omit=dev",
    "audit:all": "npm audit --audit-level=moderate",
    "dead-code": "npx knip",
    "circular": "dpdm --no-warning --no-tree --transform --extensions ts,tsx --exit-code circular:0 src/main/index.ts src/renderer/src/main.tsx",
    "check:full": "npm run lint && npm run lint:forbidden && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && npm test && npm run circular && npm run dead-code && npm run audit:ci"
  },
  "keywords": [
    "dnd",
    "virtual-tabletop",
    "electron"
  ],
  "author": {
    "name": "D&D Virtual Tabletop"
  },
  "license": "ISC",
  "build": {
    "appId": "com.dnd-vtt.app",
    "productName": "D&D Virtual Tabletop",
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/chunk-index.json",
        "to": "chunk-index.json"
      }
    ],
    "files": [
      "!**/.vscode/*",
      "!src/**/*",
      "!scripts/**/*",
      "!5.5e References/**/*",
      "!bmo/**/*",
      "!Tests/**/*",
      "!.claude/**/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}",
      "!{biome.json,knip.json,vitest.config.ts,package-lock.json,audit-prompt.md}",
      "!**/*.ps1",
      "!CLAUDE.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "EvilPatrick06",
      "repo": "home-lab",
      "releaseType": "release",
      "timeout": 300000
    },
    "fileAssociations": [
      {
        "ext": "dndvtt",
        "name": "D&D VTT Export",
        "description": "D&D Virtual Tabletop character/campaign export",
        "role": "Editor"
      }
    ],
    "win": {
      "executableName": "dnd-vtt",
      "icon": "resources/icon.ico",
      "legalTrademarks": "D&D Virtual Tabletop",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "include": "resources/installer.nsh"
    },
    "linux": {
      "executableName": "dnd-vtt",
      "icon": "resources/icon.png",
      "category": "Game",
      "synopsis": "Electron desktop VTT for D&D 5e",
      "description": "D&D Virtual Tabletop — Electron desktop app for running Dungeons & Dragons 5e games. Multiplayer over peerjs with optional BMO Pi voice/AI integration.",
      "maintainer": "EvilPatrick06 <noreply@example.com>",
      "vendor": "D&D Virtual Tabletop",
      "target": [
        "AppImage"
      ]
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.AppImage"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/langgraph": "^1.3.2",
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.26",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "cannon-es": "^0.20.0",
    "dotenv": "^17.4.2",
    "dpdm": "^4.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0-beta.1",
    "fuse.js": "^7.3.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "jspdf": "^4.2.1",
    "knip": "^6.14.2",
    "license-checker": "^25.0.1",
    "lockfile-lint": "^5.0.0",
    "npm-check-updates": "^22.2.1",
    "oxlint": "^1.67.0",
    "pdfjs-dist": "^6.0.227",
    "peerjs": "^1.5.5",
    "pixi.js": "^8.18.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "three": "^0.184.0",
    "tsx": "^4.22.3",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/generative-ai": "^0.24.1",
    "bonjour-service": "^1.4.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "i18next": "^26.3.0",
    "lucide-react": "^1.17.0",
    "multicast-dns": "^7.2.5",
    "openai": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "postcss": ">=8.5.10",
    "minimatch": ">=10.2.1",
    "scheduler": "0.27.0",
    "fs-extra": "11.3.3",
    "commander": "12.1.0",
    "chalk": "4.1.2",
    "semver": "7.7.4",
    "entities": "4.5.0"
  }
}
